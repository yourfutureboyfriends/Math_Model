# =============================================================================
# Helper Utilities
# =============================================================================

def safe_hex_to_rgb(color: str) -> tuple:
    """
    Safely convert a hex color string to (r, g, b) integers.

    FIXED: Guards against rgba() strings, short hex, or malformed values
    so that the days_warning_html block never raises ValueError.
    Returns (128, 128, 128) as a safe grey fallback on any parse failure.
    """
    try:
        color = color.strip()
        if color.startswith("#") and len(color) == 7:
            return int(color[1:3], 16), int(color[3:5], 16), int(color[5:7], 16)
    except (ValueError, IndexError):
        pass
    return 128, 128, 128  # FIXED: neutral grey fallback


