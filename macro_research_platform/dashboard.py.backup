# =============================================================================
# JavaScript to hide leaked Material icon text using components
# =============================================================================

st.html("""
<script>
// ============================================================
// Material Icon Text Suppressor — Streamlit v1.25 through v1.56+
// ============================================================
// CRITICAL: components.html() runs inside a sandboxed <iframe>.
// Using `document` alone only reaches the iframe's own empty DOM.
// We must use `window.parent.document` to reach the Streamlit
// shell DOM where the toolbar, sidebar toggle, and app content live.
//
// When Material Symbols fonts fail to load from Google Fonts CDN,
// Streamlit renders icon ligature names as plain text:
//   - Sidebar toggle:  "double_arrow_right"
//   - Toolbar buttons: "contrast", "light_mode", "dark_mode"
//   - Expander arrows: "_arr", "expand_more"
// This script hides every such text node via MutationObserver.
(function() {
    'use strict';

    // Access the PARENT document (Streamlit's actual page), not the iframe.
    var parentDoc;
    try {
        parentDoc = window.parent.document;
    } catch(e) {
        // Cross-origin sandbox — fall back to own document (less effective)
        parentDoc = document;
    }

    // ---- Icon detection ----

    const EXACT_ICONS = new Set([
        // Sidebar / navigation
        'double_arrow_right','double_arrow_left','double_arrow',
        'arrow_right','arrow_left','arrow_back','arrow_forward',
        'chevron_right','chevron_left',
        'keyboard_arrow_right','keyboard_arrow_left',
        'keyboard_arrow_down','keyboard_arrow_up',
        'expand_more','expand_less','_arr',
        // Toolbar / hamburger menu (Streamlit v1.56)
        'contrast','light_mode','dark_mode','brightness_4','brightness_7',
        'contrast_light_mode','light_mode_dark_mode',
        'contrast_light_mode_dark_mode',
        'share','download','menu','more_vert','more_horiz',
        'fullscreen','fullscreen_exit','close','search','settings',
        'open_in_new','code','bug_report','help','help_outline',
        'info','info_outline','warning','error_outline','check_circle',
        // Deploy / cloud
        'cloud_upload','cloud_done','rocket_launch','deployed_code',
        'publish','publish_outlined',
    ]);

    const ICON_FRAGMENTS = [
        'double_arrow','_arrow','arrow_','light_mode','dark_mode',
        'contrast','_icon','material_',
    ];

    function looksLikeIcon(text) {
        if (!text) return false;
        const t = text.trim();
        if (t.length === 0 || t.length > 60) return false;
        if (EXACT_ICONS.has(t)) return true;
        if (t.startsWith('_arr') || t.includes('double_arrow')) return true;
        for (let i = 0; i < ICON_FRAGMENTS.length; i++) {
            if (t.indexOf(ICON_FRAGMENTS[i]) !== -1) return true;
        }
        // snake_case string containing known icon vocabulary words
        if (/^[a-z][a-z0-9_]{3,}$/.test(t) && t.indexOf('_') !== -1) {
            const iconVocab = ['arrow','chevron','keyboard','expand','double',
                'light','dark','mode','more','menu','close','search','share',
                'settings','fullscreen','contrast','brightness','cloud',
                'code','error','info','help','launch','rocket'];
            const words = t.split('_');
            for (let i = 0; i < words.length; i++) {
                if (iconVocab.indexOf(words[i]) !== -1) return true;
            }
        }
        return false;
    }

    function hideNode(el) {
        if (!el || el.tagName === 'SCRIPT' || el.tagName === 'STYLE') return;
        el.style.setProperty('font-size',   '0',           'important');
        el.style.setProperty('line-height', '0',           'important');
        el.style.setProperty('color',       'transparent', 'important');
        el.style.setProperty('user-select', 'none',        'important');
        el.setAttribute('aria-hidden', 'true');
    }

    function suppressIconNodes(root) {
        var scanRoot = root || (parentDoc && parentDoc.body) || document.body;
        if (!scanRoot) return;
        var walker = parentDoc.createTreeWalker(
            scanRoot,
            NodeFilter.SHOW_TEXT,
            null,
            false
        );
        var node;
        while ((node = walker.nextNode())) {
            if (looksLikeIcon(node.textContent)) {
                hideNode(node.parentElement);
            }
        }
    }

    // Run immediately and at staggered delays to catch late-rendered elements
    function runAll() { suppressIconNodes(null); }
    runAll();
    setTimeout(runAll, 80);
    setTimeout(runAll, 300);
    setTimeout(runAll, 800);
    setTimeout(runAll, 2000);

    // MutationObserver on the PARENT document body
    if (parentDoc && parentDoc.body) {
        var observer = new MutationObserver(function(mutations) {
            var needsScan = false;
            for (var i = 0; i < mutations.length; i++) {
                if (mutations[i].addedNodes.length > 0) { needsScan = true; break; }
            }
            if (needsScan) setTimeout(runAll, 30);
        });
        observer.observe(parentDoc.body, { childList: true, subtree: true });
    }
})();
</script>
""")


# =============================================================================
# Imports
# =============================================================================

from settings import DATA_SOURCE
from src.data import load_model_data, get_data_status, DataModeError
from src.features.macro_features import compute_all_transforms
from src.models.macro_regime.regime_model import (
    compute_group_scores, compute_score_directions, get_current_scores
)
from src.models.macro_regime.classifier import classify_regime, get_regime_history
from src.models.portfolio_construction.sector_allocation_model import ConfigDrivenSectorModel
from src.models.recession_risk.recession_model import get_current_recession_probability
from src.models.business_conditions import BusinessConditionsModel
from src.reporting.memo_generator import generate_detailed_memo
from src.reporting.report_generator import export_all_reports
from src.reporting.hedge_fund_style import get_data_to_watch

# FIXED: Auto-detect data mode — if processed live data exists on disk, default
# to "live" so the dashboard is consistent with pipeline-generated outputs.
# The old hard-coded default "sample" caused the dashboard to show sample-data
# scores while the regime/signals in latest_model_results.json were computed
# from live data, producing a visible inflation-score vs. regime mismatch.
_env_mode = os.getenv("MACRO_DATA_MODE", "").strip().lower()
if _env_mode:
    DATA_MODE = _env_mode
else:
    _live_processed = Path(__file__).parent / "data" / "processed" / "live" / "macro_data.parquet"
    DATA_MODE = "live" if _live_processed.exists() else "sample"
logger.info("DATA_MODE resolved to: %s", DATA_MODE)


# =============================================================================
# Data Loading Functions
# =============================================================================

@st.cache_data(ttl=3600)  # Cache for 1 hour in live mode
def load_and_process(mode=DATA_MODE):
    """Load and process all macro data."""
    df_raw, metadata = load_model_data(mode=mode)

    if df_raw.empty:
        raise ValueError("No data loaded")

    df_trans = compute_all_transforms(df_raw)
    scores_df = compute_group_scores(df_trans)
    directions = compute_score_directions(scores_df)
    scores = get_current_scores(scores_df)

    regime = classify_regime(directions["growth"], directions["inflation"])
    regime_hist = get_regime_history(scores_df)

    # FIXED: Compute recession_prob BEFORE sector model so we can pass it in.
    # Previously it was computed AFTER the sector model call, making the sector
    # model always use the default recession_prob=0.0.
    try:
        recession_prob = get_current_recession_probability(df_raw)
    except Exception:  # FIXED: bare except -> except Exception
        recession_prob = 0.0

    # Sector allocation
    # FIXED: Previously credit_stress_score=0.0 (hardcoded) and
    # financial_conditions defaulted to "neutral", ignoring actual data.
    # Now: derive financial_conditions from the liquidity direction so
    # rate-sensitive sectors are penalised during tightening cycles; pass
    # recession_prob as a decimal (model expects 0–1, not 0–100).
    _liq_dir = directions.get("liquidity", "stable")
    _fc_impulse = (
        "easing" if _liq_dir == "loosening"
        else "tightening" if _liq_dir == "tightening"
        else "neutral"
    )
    # Recession probability: convert from percentage (e.g. 5.3%) to decimal
    _rec_decimal = recession_prob / 100.0 if recession_prob > 1.0 else recession_prob

    sector_model = ConfigDrivenSectorModel()
    sector_results = sector_model.score_all_sectors(
        regime=regime,
        growth_score=scores["growth"],
        liquidity_score=scores["liquidity"],
        credit_stress_score=max(0.0, scores.get("risk", 0.0) * -1),  # risk score inverted as proxy for stress
        financial_conditions=_fc_impulse,
        recession_prob=_rec_decimal,
    )

    # Additional metrics (recession_prob already computed above)

    try:
        bc_model = BusinessConditionsModel()
        bc_result = bc_model.nowcast(df_trans)
        nowcast = {"score": bc_result.score, "direction": bc_result.direction, "confidence": bc_result.confidence}
    except Exception:  # FIXED: bare except -> except Exception
        nowcast = None

    return {
        "df_raw": df_raw,
        "scores_df": scores_df,
        "directions": directions,
        "scores": scores,
        "regime": regime,
        "regime_hist": regime_hist,
        "sector_table": sector_results,
        "recession_prob": recession_prob,
        "nowcast": nowcast,
        "metadata": metadata,
    }


def get_file_mtime(path):
    """Get file modification time for cache invalidation."""
    if path.exists():
        return path.stat().st_mtime
    return 0


@st.cache_data(ttl=3600)  # Cache for 1 hour
def load_model_results_json():
    """Load enhanced classification results from pipeline JSON."""
    json_path = Path(__file__).parent / "outputs" / "latest_model_results.json"
    if json_path.exists():
        with open(json_path) as f:
            return json.load(f)
    return {}


# Load with file modification time to ensure cache invalidation
json_path = Path(__file__).parent / "outputs" / "latest_model_results.json"
json_mtime = get_file_mtime(json_path)
if 'json_mtime' not in st.session_state:
    st.session_state['json_mtime'] = json_mtime


# =============================================================================
# Load Data with Spinner
# =============================================================================

try:
    with st.spinner("Loading macro data..."):
        data = load_and_process(mode=DATA_MODE)
        model_results = load_model_results_json()
        st.session_state.data_loaded = True
        st.session_state.last_refresh = datetime.now()
    regime_classification = model_results.get("regime_classification", {})
    latest_date = data["df_raw"].index[-1]
    latest_date_str = latest_date.strftime("%B %Y")
except Exception as e:  # FIXED: bare except -> except Exception
    st.error(f"Failed to load data: {e}")
    st.stop()


# =============================================================================
# Sidebar - Professional Navigation
# =============================================================================

st.sidebar.markdown(f"""
<div style="padding-bottom: 14px; border-bottom: 2px solid {current_theme.primary}; margin-bottom: 18px;">
    <div style="font-family:'IBM Plex Mono','Courier New',monospace;
                font-size: 13px; font-weight: 700; letter-spacing: 0.10em;
                color: {current_theme.primary}; text-transform: uppercase;">
        &#9646; MACRO RESEARCH
    </div>
    <div style="font-family:'IBM Plex Mono',monospace; font-size: 9px;
                color: {current_theme.text_subtle}; letter-spacing: 0.08em;
                text-transform: uppercase; margin-top: 3px;">
        Institutional Regime Analysis
    </div>
</div>
""", unsafe_allow_html=True)

# Data status info
data_status_info = get_data_status()
json_data_mode = model_results.get("data_mode", "sample")
is_sample = json_data_mode == "sample"

# Get series count
if data_status_info.get("live_processed_exists") and not is_sample:
    try:
        live_df = pd.read_parquet(data_status_info.get("processed_path"))
        live_series_count = len([c for c in live_df.columns if not c.startswith('_')])
    except Exception:  # FIXED: bare except -> except Exception
        live_series_count = data_status_info.get("live_raw_files", 0)
else:
    live_series_count = data_status_info.get("live_raw_files", 0) if not is_sample else 0

# FIXED: Strip timezone info from latest_date before comparing to datetime.now()
# to avoid TypeError when latest_date is tz-aware and current_date is tz-naive.
current_date = datetime.now()
latest_date_naive = (
    latest_date.to_pydatetime().replace(tzinfo=None)
    if hasattr(latest_date, "to_pydatetime")
    else latest_date
)

if latest_date_naive > current_date:
    st.error(f"⚠️ **DATA ERROR:** Latest data date is in the future.")
    days_since = 0
    date_error = True
else:
    days_since = (current_date - latest_date_naive).days if not is_sample else 0
    date_error = False

# Sidebar status badge
if is_sample:
    status_badge = f'<span style="background: {current_theme.warning_bg}; border: 1px solid {current_theme.warning}; color: {current_theme.warning}; padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: 600; text-transform: uppercase;">Sample Data</span>'
elif date_error:
    status_badge = f'<span style="background: {current_theme.danger_bg}; border: 1px solid {current_theme.danger}; color: {current_theme.danger}; padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: 600; text-transform: uppercase;">Invalid Date</span>'
elif days_since <= 45:
    status_badge = f'<span style="background: {current_theme.success_bg}; border: 1px solid {current_theme.success}; color: {current_theme.success}; padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: 600; text-transform: uppercase;">Current</span>'
elif days_since <= 90:
    status_badge = f'<span style="background: {current_theme.warning_bg}; border: 1px solid {current_theme.warning}; color: {current_theme.warning}; padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: 600; text-transform: uppercase;">Acceptable</span>'
else:
    status_badge = f'<span style="background: {current_theme.danger_bg}; border: 1px solid {current_theme.danger}; color: {current_theme.danger}; padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: 600; text-transform: uppercase;">Stale</span>'

# Color-code days since update
days_color = current_theme.success if days_since <= 3 else (current_theme.warning if days_since <= 14 else current_theme.danger)
days_icon = "" if days_since <= 3 else ("⚠️ " if days_since <= 14 else "🚨 ")

# FIXED: Use safe_hex_to_rgb() helper to avoid ValueError when days_color is
# an rgba() string (e.g. on certain theme overrides) rather than a hex string.
r, g, b = safe_hex_to_rgb(days_color)
days_warning_html = f"""
