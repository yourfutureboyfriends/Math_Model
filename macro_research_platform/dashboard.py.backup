risk_change = (data["scores_df"]["risk_score"].iloc[-1] - data["scores_df"]["risk_score"].iloc[-4]) if len(data["scores_df"]) >= 4 else 0

fc_interp = interpret_financial_conditions_ease(data["scores"]["liquidity"], fc_change)
risk_interp = interpret_risk_appetite(data["scores"]["risk"], risk_change)
rec_interp = interpret_recession_risk(data["recession_prob"])

render_key_metrics_section(
