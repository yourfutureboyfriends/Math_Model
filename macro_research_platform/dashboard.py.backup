regime = regime_classification.get("regime", data["regime"])
regime_confidence = regime_classification.get("confidence", "unknown")
confidence_score = regime_classification.get("confidence_score", 0.0)

# Calculate interpretations
growth_change = (data["scores_df"]["growth_score"].iloc[-1] - data["scores_df"]["growth_score"].iloc[-4]) if len(data["scores_df"]) >= 4 else 0
inflation_change = (data["scores_df"]["inflation_score"].iloc[-1] - data["scores_df"]["inflation_score"].iloc[-4]) if len(data["scores_df"]) >= 4 else 0

growth_interp = interpret_growth(data["scores"]["growth"], growth_change)
inflation_interp = interpret_inflation(data["scores"]["inflation"], inflation_change)

validation_warnings = regime_classification.get("validation_warnings", [])
supporting_evidence = regime_classification.get("supporting_evidence", [])

credit_stress = model_results.get("credit_stress", {}).get("stress_level", "normal")

render_executive_summary_section(
    regime=regime,
    regime_confidence=regime_confidence,
    confidence_score=confidence_score,
    scores=data["scores"],
    growth_interp=growth_interp,
    inflation_interp=inflation_interp,
    recession_prob=data["recession_prob"],
    credit_stress=credit_stress,
    validation_warnings=validation_warnings,
    supporting_evidence=supporting_evidence,
)


