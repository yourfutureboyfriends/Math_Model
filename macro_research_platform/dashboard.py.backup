def init_session_state():
    """Initialize all session state keys with defaults."""
    defaults = {
        "expanded_sections": {},
        "selected_regime": None,
        "data_loaded": False,
        "theme": "dark",
        "last_refresh": None,
        "show_data_popup": False,
    }
    for key, val in defaults.items():
        if key not in st.session_state:
            st.session_state[key] = val

init_session_state()


