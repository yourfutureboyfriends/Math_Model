# Production Environment Configuration
# Phase 5B - Production Deployment Prep

VITE_API_URL=/api
# VITE_WS_URL is deliberately unset: Vite loads .env values literally and does not expand
# ${...}, so a templated value reached the browser as the string "wss://${window.location.host}/ws".
# With it unset, getWsBaseUrl() derives the socket origin from the page (wss://<host>) and
# getWebSocketUrl() appends /ws/<name> once. Set this only to a fully-qualified static URL
# when the socket is served from a different origin than the app.
VITE_APP_NAME=MACRO OSv8.0
VITE_APP_VERSION=8.0.0

# Feature flags
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_ANALYTICS=true
VITE_DEBUG_MODE=false

# API timeouts (ms)
VITE_API_TIMEOUT=30000
VITE_WS_RECONNECT_DELAY=5000
