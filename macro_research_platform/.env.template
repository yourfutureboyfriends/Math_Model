# ═══════════════════════════════════════════════════════════════════════════════
# Macro Research Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ── Data Sources ───────────────────────────────────────────────────────────────
# FRED API Key (free at https://fred.stlouisfed.org/)
FRED_API_KEY=your_fred_api_key_here

# ── Alert Delivery ─────────────────────────────────────────────────────────────
# Email (SMTP) Configuration
# Supports Gmail, Outlook, or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL_TO=recipient@hedge-fund.com

# Slack Webhook (create at https://api.slack.com/apps)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite is default (no config needed)
# DB_PATH=database/macro_platform.db

# ── WebSocket (optional) ────────────────────────────────────────────────────────
# WS_PORT=8000
