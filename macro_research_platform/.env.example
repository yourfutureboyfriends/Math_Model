# ═══════════════════════════════════════════════════════════════════════════════
# Macro Research Platform — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# API KEYS (Free tiers available)
# ═══════════════════════════════════════════════════════════════════════════════

# FRED API Key — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
# SEC EDGAR (free fundamentals, no key) requires a User-Agent naming you with a contact email,
# per SEC fair-access rules, e.g. "Jane Doe jane@example.com". A placeholder default is used if unset.
SEC_USER_AGENT=

# Finnhub API Key — https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_key_here

# News API Key — https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# Data Integrity Alerting (Optional)
# Alert when dashboard validation fails
# ═══════════════════════════════════════════════════════════════════════════════

# Enable alerting (true/false)
ALERT_EMAIL_ENABLED=false

# Minimum seconds between alerts (prevents spam)
ALERT_INTERVAL_SECONDS=300

# Email from address
ALERT_EMAIL_FROM=alerts@localhost

# ═══════════════════════════════════════════════════════════════════════════════
# Email SMTP Configuration (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL_TO=recipient@your-fund.com

# ═══════════════════════════════════════════════════════════════════════════════
# Slack Alert Configuration (Optional)
# Create webhook at: https://api.slack.com/apps
# ═══════════════════════════════════════════════════════════════════════════════

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ═══════════════════════════════════════════════════════════════════════════════
# Platform Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Display name in reports
PLATFORM_NAME=Macro Research Platform
FUND_NAME=Your Fund Name

# AUM for risk analytics ($M)
AUM_DISPLAY=100

# Default timezone for timestamps
DEFAULT_TIMEZONE=America/New_York

# ═══════════════════════════════════════════════════════════════════════════════
# Data Source Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Options:
#   "sample"  - Use local CSV only (default, no API needed)
#   "fred"    - Pull from FRED API (requires FRED_API_KEY)
#   "mixed"   - FRED data + manual overrides (recommended for production)
MACRO_DATA_SOURCE=sample

# How many hours before refreshing FRED cache (default: 24)
MACRO_REFRESH_CACHE_HOURS=24

# ═══════════════════════════════════════════════════════════════════════════════
# Security (REQUIRED for production!)
# ═══════════════════════════════════════════════════════════════════════════════

# Environment - One of: development, test, ci, staging, production
ENVIRONMENT=development

# JWT Secret (generate with: openssl rand -hex 32)
# MUST be set in production environments
JWT_SECRET=change-this-to-a-secure-64-character-secret

# Flask secret key (generate with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-random-64-character-string

# Allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# ═══════════════════════════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=INFO
LOG_FILE=/app/logs/macro_platform.log

# ═══════════════════════════════════════════════════════════════════════════════
# Model Hyperparameters (optional overrides)
# ═══════════════════════════════════════════════════════════════════════════════

# Rolling window for z-score computation in months (default: 36)
# MACRO_ZSCORE_WINDOW=36

# Window for score direction calculation in months (default: 3)
# MACRO_DIRECTION_WINDOW=3

# Threshold for direction classification (default: 0.10)
# MACRO_DIRECTION_THRESHOLD=0.10

# Maximum single sector weight as decimal (default: 0.25 = 25%)
# MACRO_MAX_SECTOR_WEIGHT=0.25

# Minimum single sector weight as decimal (default: 0.05 = 5%)
# MACRO_MIN_SECTOR_WEIGHT=0.05

# Regime changes in 6 months to flag uncertainty (default: 2)
# MACRO_REGIME_CHANGE_THRESHOLD=2

# Z-score change threshold for rapid shift warning (default: 1.0)
# MACRO_RAPID_SHIFT_THRESHOLD=1.0

# ═══════════════════════════════════════════════════════════════════════════════
# Phase 5: Runtime Validation & Diagnostics Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Runtime validation - validates payload data before returning from handlers
# Options: true (default), false
ENABLE_RUNTIME_VALIDATION=true

# Event logging - logs signal, forecast, and risk events to database
# Options: true (default), false
ENABLE_EVENT_LOGGING=true

# Diagnostics - enables detailed diagnostics endpoints
# Options: true (default), false
ENABLE_DIAGNOSTICS=true

# Audit logging - logs all audit events to AuditLog table
# Options: true (default), false
ENABLE_AUDIT_LOGGING=true

# Provenance tracking - tracks data lineage for all ingested data
# Options: true, false (default - more expensive operation)
ENABLE_PROVENANCE_TRACKING=false

# ── Database (docker-compose) ────────────────────────────────────────────────
# Required by docker-compose: there is no default password. Choose a strong value.
DB_PASSWORD=
# Used by Alembic migrations and Celery tasks, e.g.
# DATABASE_URL=postgresql+asyncpg://macro:<DB_PASSWORD>@localhost:5432/macro_terminal
DATABASE_URL=

# AI assistant: a free Groq key (console.groq.com) — OpenAI-compatible, supports tool calls
GROQ_API_KEY=

# Live global ship positions (SHIP): free key from https://aisstream.io (sign in with GitHub) — optional;
# without it the live-vessel map uses Finland's open Digitraffic AIS (Baltic Sea only)
AISSTREAM_API_KEY=

# ── Alerts and Daily Brief delivery (optional; nothing is sent unless a channel is set) ──
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...      # Slack / Discord / Teams / ntfy.sh
# ALERT_SMTP_HOST=smtp.example.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=
# BRIEF_DELIVERY_TIME=07:00                                    # send the Daily Brief each weekday at this time
# BRIEF_DELIVERY_TZ=America/New_York

# Optional licensed global tracker feeds. Nothing paid is queried without all three:
# enabled=true, valid credentials, and a positive daily request/connection cap.
# Request counts are NOT monetary budgets. Set them to match your provider contract.
TRACKING_SHIPXY_ENABLED=false
SHIPXY_API_KEY=
TRACKING_SHIPXY_DAILY_REQUESTS=0
TRACKING_KPLER_ENABLED=false
KPLER_AIS_TOKEN=
TRACKING_KPLER_DAILY_REQUESTS=0
TRACKING_VESSELFINDER_ENABLED=false
VESSELFINDER_API_KEY=
TRACKING_VESSELFINDER_DAILY_REQUESTS=0
# VesselFinder LiveData uses the geographic area and data sources in your subscription.
TRACKING_POLL_SECONDS=900
TRACKING_MAX_PAGES=1
TRACKING_FLIGHTAWARE_ENABLED=false
FLIGHTAWARE_FIREHOSE_USERNAME=
FLIGHTAWARE_FIREHOSE_API_KEY=
TRACKING_FLIGHTAWARE_DAILY_REQUESTS=0
# South west north east; initial scope is Asia. Requires the corresponding subscription.
FLIGHTAWARE_FIREHOSE_BOUNDS=5 60 55 145
# Aireon positions must be included in your FlightAware entitlement; no access is implied.

# Versioned neural sequence research. XL increases capacity, not guaranteed accuracy.
# Networks remain challengers until the out-of-sample/live/human review gate passes.
ML_DEEP_PROFILE=expanded
ML_DEEP_SEEDS=5
ML_DEEP_EPOCHS=150
ML_DEEP_SEED_SECONDS=120
# ML_DEEP_PROFILE=research_xl  # 256 hidden units, four recurrent layers, 8 attention heads

# Daily market-data learning checks; bounded weekly research refits, existing promotion gates retained.
ML_AUTO_LEARN=1

# Continuous provider freshness/quality supervisor; uses existing provider entitlements.
ML_ONLINE_ENABLED=1

# Integrated autonomous learning uses the existing AI_PROVIDER configuration.
ML_AUTONOMOUS_ENABLED=1
ML_AUTONOMOUS_SEED_EPOCHS=6
ML_AUTONOMOUS_SEED_SECONDS=120
# Six additional configured-provider calls per evidence-bearing day when enabled.
ML_DEBATE_ENABLED=1
